# Path of the legally obtained client package, relative to the repository root.
TOPSAP_DEB=packages/TopSAP-3.5.2.36.2-x86_64.deb

# VPN gateway used by the TLS relay. This is not an SSH destination.
VPN_GATEWAY_HOST=vpn.example.org
VPN_GATEWAY_PORT=44443
VPN_RELAY_PORT=44443

# Set to yes only when your VPN policy permits disconnecting an existing session.
VPN_KICK_EXISTING=no

# SOCKS5 accepts TCP connections to arbitrary VPN-reachable hosts. It is always bound to 127.0.0.1.
SOCKS_HOST_PORT=1088

# Fixed TCP forward for exactly one VPN-reachable SSH host. SSH credentials are supplied by your SSH client, not here.
SSH_TARGET=VPN_TARGET_IP
SSH_TARGET_PORT=22
SSH_FORWARD_LISTEN_PORT=10022
SSH_FORWARD_HOST_PORT=10022

# Use 127.0.0.1 for local-only access. Use 0.0.0.0 only with an appropriate firewall rule.
SSH_FORWARD_BIND_ADDRESS=127.0.0.1
